# ---- local secrets ----
.env
**/.env
*.pem
*.key
*.p12

# ---- local data / account state ----
*.db
social-auto-upload-main/db/*.db
social-auto-upload-main/db/backups/
social-auto-upload-main/cookies/
social-auto-upload-main/cookiesFile/
social-auto-upload-main/videoFile/
social-auto-upload-main/logs/
/logs/

# ---- runtime output ----
*.log
backend*.log
frontend*.log
*.zip
/*-check.json
social-auto-upload-main/*-check.json
social-auto-upload-main/verify_code.txt
social-auto-upload-main/dm_media/
social-auto-upload-main/debug_ui_core_*.png
*.db-wal
*.db-shm

# ---- local browser probes / downloaded bundles ----
/debug/
/xhs_*
/flowops_xhs_*.png
/bundler-runtime.*.js
/library-launcher.*.js
/.workbuddy-ai/
.ruff_cache/
.coverage
htmlcov/

# ---- 本地分析 / 诊断产物（脚本、截图、数据库快照，不进仓库）----
/_re/
/tmp_diag/
/tmp_diag_*.py
social-auto-upload-main/db/*.bak-*

# ---- Python ----
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ---- Node / frontend build ----
node_modules/
dist/
.vite/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 部署产物（deploy/ 下的运行期数据，不进仓库）----
deploy/data/
deploy/backups/
deploy/.env.deploy
deploy/out/

# ---- 本地演示/调试产物（截图、录屏、探针脚本输出，不进仓库）----
.demo-artifacts/

# ---- keep empty runtime directories ----
!social-auto-upload-main/cookies/.gitkeep
!social-auto-upload-main/cookiesFile/.gitkeep
!social-auto-upload-main/videoFile/.gitkeep
!social-auto-upload-main/logs/.gitkeep

