# 云策 YunCe 部署环境变量
# 复制成 .env.deploy 再改：cp .env.deploy.example .env.deploy
# 权限建议：chmod 600 .env.deploy

# ============ 监听与鉴权（这三项缺一不可）============
# 容器/服务器内必须监听 0.0.0.0，否则外面进不来
YUNCE_HOST=0.0.0.0
# 改端口要同步改 docker-compose.yml 的 ports 映射
YUNCE_PORT=5409
# 非回环地址 + 没有 ALLOW_REMOTE=1 -> 后端直接拒绝启动
YUNCE_ALLOW_REMOTE=1
# 没设置令牌 -> 后端也拒绝启动。生成：openssl rand -hex 24
YUNCE_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_24
# 同源部署（Nginx 反代到同一个域名）留空即可；
# 前端放在别的域名时填来源，多个用逗号分隔：https://ops.example.com,https://ops2.example.com
YUNCE_CORS_ORIGINS=
# INFO / DEBUG
YUNCE_LOG_LEVEL=INFO

# ============ 真实浏览器登录窗口（noVNC）============
# 登录窗口默认走截图流；若账号选择页/扫码页操作不顺畅，可开启网页 VNC，
# 在浏览器里直接操作服务器上的真实 Chromium 桌面（与本地浏览器手感一致）。
YUNCE_VNC_ENABLED=1
# Nginx /novnc/ 的 HTTP Basic Auth 账号密码（也是前端提示里显示的凭据）
YUNCE_VNC_USER=yunce
YUNCE_VNC_PASSWORD=CHANGE_ME_vnc_password

# ============ AI 文案（OpenAI Responses 兼容）============
WB_API_KEY=
WB_BASE_URL=
WB_MODEL=
WB_REALM=cn

# ============ 运营通知 webhook（可留空）============
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TYPE=auto
