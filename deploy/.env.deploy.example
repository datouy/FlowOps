# 云策 YunCe 部署环境变量
# 复制成 .env.deploy 再改：cp .env.deploy.example .env.deploy
# 权限建议：chmod 600 .env.deploy

# ============ 监听与鉴权（这三项缺一不可）============
# 容器/服务器内必须监听 0.0.0.0，否则外面进不来
YUNCE_HOST=0.0.0.0
# 改端口要同步改 docker-compose.yml 的 ports 映射
YUNCE_PORT=5409
# 非回环地址 + 没有 ALLOW_REMOTE=1 -> 后端直接拒绝启动
YUNCE_ALLOW_REMOTE=1
# 没设置令牌 -> 后端也拒绝启动。生成：openssl rand -hex 24
YUNCE_ACCESS_TOKEN=CHANGE_ME_openssl_rand_hex_24
# 企业协作使用个人账号登录；令牌保留为首次引导和应急管理员入口
YUNCE_PERSONAL_AUTH=1
FLOWOPS_LOGIN_ATTEMPT_LIMIT=10
FLOWOPS_LOGIN_IP_LIMIT=60
FLOWOPS_LOGIN_ATTEMPT_WINDOW=300
FLOWOPS_LOGIN_FAILURE_LIMIT=10
FLOWOPS_LOGIN_IP_FAILURE_LIMIT=60
FLOWOPS_LOGIN_FAILURE_WINDOW=900
FLOWOPS_LOGIN_LOCK_SECONDS=900
# 同源部署（Nginx 反代到同一个域名）留空即可；
# 前端放在别的域名时填来源，多个用逗号分隔：https://ops.example.com,https://ops2.example.com
YUNCE_CORS_ORIGINS=
# INFO / DEBUG
YUNCE_LOG_LEVEL=INFO
FLOWOPS_SECRET_KEY=CHANGE_ME_long_random_secret

# ============ AI 文案（OpenAI Responses 兼容）============
WB_API_KEY=
WB_BASE_URL=https://your-ai.example/v1
WB_MODEL=
WB_REALM=cn
FLOWOPS_AI_DAILY_LIMIT=200
WB_INPUT_COST_PER_1M=0
WB_OUTPUT_COST_PER_1M=0

# 媒体配额（GB，0=仅检查磁盘空间）
FLOWOPS_MEDIA_QUOTA_GB=0
FLOWOPS_PUBLISH_WORKERS=2
FLOWOPS_EXECUTOR_LEASE=120
# docker-compose.yml 默认 all；使用 docker-compose.split.yml 时由编排覆盖
FLOWOPS_PROCESS_ROLE=all
# split 编排会在两个容器内分别设置，避免共享日志轮转竞争
FLOWOPS_LOG_DIR=logs
FLOWOPS_ACCOUNT_LEASE_SECONDS=180
FLOWOPS_SHARED_BROWSER_SHARDS=2

# 远端选择器适配包（可选，开启后必须同时配置密钥）
FLOWOPS_ADAPTER_URL=
FLOWOPS_ADAPTER_KEY=

# ============ 运营通知 webhook（可留空）============
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TYPE=auto
