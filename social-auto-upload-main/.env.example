# WorkBuddy Gateway / OpenAI Responses compatible endpoint
WB_API_KEY=your_api_key_here
WB_BASE_URL=http://106.55.225.14/v1
WB_MODEL=deepseek-v4.1-flash
WB_REALM=cn
# 企业微信机器人、飞书机器人或通用 webhook 地址
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TYPE=auto

# ---- 服务监听与访问控制 ----
# 默认只监听 127.0.0.1（仅本机可访问）。需要手机/另一台电脑访问时改成 0.0.0.0，
# 同时设置 YUNCE_ALLOW_REMOTE=1，并务必设置 YUNCE_ACCESS_TOKEN；
# 缺少任一项后端会拒绝启动，避免同网段任何人操作你的账号。
YUNCE_HOST=127.0.0.1
YUNCE_PORT=5409
YUNCE_ALLOW_REMOTE=0
# 留空表示不校验令牌；设置后前端需在 localStorage 写入 yunce_access_token，
# 或在请求头带 X-YunCe-Token。
YUNCE_ACCESS_TOKEN=
# 额外允许的跨域来源，逗号分隔；留空默认只允许 localhost:5173 与 127.0.0.1:5173
YUNCE_CORS_ORIGINS=

# ---- 凭据加密主密钥 ----
# cookiesFile/ 下的账号登录态（cookie + localStorage）现在用 AES-256-GCM
# 加密落盘。这个环境变量是主密钥的来源之一（口令，会经 PBKDF2 派生）。
#
# 留空时的行为：优先用系统凭据库（Windows DPAPI / macOS Keychain /
# Linux keyring）；都没有则在本机 db/.master_key 生成一个降级密钥。
#
# 生产环境请务必设置它：换机器、重装系统或清理 dp/ 目录后，降级密钥会丢，
# 已保存的账号凭据将无法解密，只能重新扫码登录。
FLOWOPS_SECRET_KEY=

# ---- 发布限流与降速 ----
# 直接降低封号风险的三道闸门。默认值偏保守（宁可慢，不要被封）。
# 每账号每分钟最多发布多少次（令牌桶）。
FLOWOPS_PUBLISH_RATE_PER_MIN=6
# 同一平台允许的并发发布数（信号量）。
FLOWOPS_PUBLISH_PLATFORM_CONCURRENCY=2
# 夜间降速开关：22:00-07:00 把速率降到 30%。
FLOWOPS_PUBLISH_NIGHT_THROTTLE=1
# 夜间时段（24 小时制，可覆盖）。
FLOWOPS_PUBLISH_NIGHT_START=22
FLOWOPS_PUBLISH_NIGHT_END=7

